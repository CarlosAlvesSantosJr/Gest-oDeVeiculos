# Copie para .env e ajuste. Todos os valores têm padrão no docker-compose.yml.

# Porta do painel/gateway no host
HTTP_PORT=8080

# Código de acesso do gerente no celular (TROQUE em produção!)
MANAGER_TOKEN=gerente123

# Cadastra veículos de demonstração na primeira execução
SEED_DEMO=true

RABBITMQ_USER=oficina
RABBITMQ_PASS=oficina123

# Dados que aparecem na mensagem do WhatsApp
OFICINA_NOME=Mecânica Auto Marcas
OFICINA_HORARIO=de segunda a sexta, das 8h às 18h

# Status que disparam WhatsApp (separados por vírgula)
NOTIFICAR_STATUS=PRONTO_PARA_ENTREGA

# WhatsApp: "mock" (apenas registra) ou "cloud" (WhatsApp Business Cloud API da Meta)
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nome do template aprovado na Meta (necessário fora da janela de 24h). Vazio = mensagem de texto.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=pt_BR
